# Medialane App Environment Variables
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_MEDIALANE_CONTRACT_ADDRESS=
NEXT_PUBLIC_COLLECTION_CONTRACT_ADDRESS=
NEXT_PUBLIC_COLLECTION_CONTRACT_HASH=
NEXT_PUBLIC_CONTRACT_ADDRESS_MIP=0x02611360a62f6693231a38f8941b8f90d6d408a06a598a1f24532bb2fc09d314

# Starknet Network
NEXT_PUBLIC_EXPLORER_URL=https://voyager.online

# Better Auth
DATABASE_URL=postgresql://...
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-string
BETTER_AUTH_URL=https://portal.medialane.io

# Chipi Pay SDK
NEXT_PUBLIC_CHIPI_API_KEY=
CHIPI_SECRET_KEY=
NEXT_PUBLIC_MERCHANT_WALLET=

# Credits top-up — where the console sends USDC. The Creator's Fund Starknet
# multisig (must match the backend STARKNET_X402_TREASURY). Chain-prefixed for
# multichain readiness (NEXT_PUBLIC_BASE_X402_TREASURY etc. later).
NEXT_PUBLIC_STARKNET_X402_TREASURY=0x064c51746dbcb7498cc6e4b8abfcacd60805c0762b0411bb0515c611b5ae8223

# Medialane Backend (API Portal)
MEDIALANE_API_URL=https://medialane-backend-production.up.railway.app
# Portal's own account-scoped API key — used for regular /v1/* calls like
# SIWS nonce/verify.
MEDIALANE_API_KEY=

# SMTP (Contact Form)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=