# medialane-backend. The server proxy reads MEDIALANE_API_URL first, then the public variable.
MEDIALANE_API_URL=
NEXT_PUBLIC_MEDIALANE_BACKEND_URL=
# Server-only. Used by API routes, never sent to the browser.
MEDIALANE_API_KEY=

# App URL. Metadata base, canonical and sitemap URLs. Must be the host the app serves from.
NEXT_PUBLIC_APP_URL=https://portal.medialane.io

NEXT_PUBLIC_EXPLORER_URL=https://voyager.online
# Dedicated Pinata gateway used to resolve media.
NEXT_PUBLIC_PINATA_GATEWAY=
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
